KHFULLHD_API_URL=http://127.0.0.1:8000

# Auth.js (Authentik OIDC).
# The Authentik app this points at is a PUBLIC client (PKCE), so AUTH_AUTHENTIK_SECRET
# is left empty — auth.ts sets token_endpoint_auth_method:'none'. If you instead use a
# Confidential client, fill the secret and drop the public-client config in src/auth.ts.
AUTH_SECRET=replace-with-a-generated-secret
AUTH_AUTHENTIK_ID=replace-with-the-authentik-oidc-client-id
AUTH_AUTHENTIK_SECRET=
AUTH_AUTHENTIK_ISSUER=http://localhost:9000/application/o/<app-slug>/
